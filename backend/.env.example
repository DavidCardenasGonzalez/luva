TABLE_NAME=Luva
FRIENDSHIPS_TABLE_NAME=
FRIENDSHIP_IMAGES_TABLE_NAME=
AUDIO_BUCKET=
ASSETS_BUCKET_NAME=
ASSETS_CLOUDFRONT_DOMAIN_NAME=
ASSETS_CLOUDFRONT_URL=
GENERATED_VIDEOS_TABLE_NAME=
GENERATED_VIDEOS_STATUS_PUBLISH_ON_INDEX_NAME=StatusPublishOnIndex
# Lambda/CDK reads the API key from SSM. Prod: /luva/openai/apiKey. Dev: /luva/dev/openai/apiKey.
OPENAI_KEY_PARAM=/luva/dev/openai/apiKey
# Optional for local-only runs. Do not commit a real value.
OPENAI_API_KEY=your_openai_api_key
# Lambda/CDK reads the fal.ai API key from SSM. Prod: /luva/fal/apiKey. Dev: /luva/dev/fal/apiKey.
FAL_KEY_PARAM=/luva/dev/fal/apiKey
# Optional for local-only runs. Do not commit a real value.
FAL_KEY=your_fal_api_key
FRIEND_IMAGE_WORKER_FUNCTION_NAME=
GOOGLE_TRANSLATE_API_KEY_PARAM=/luva/dev/google/translateApiKey
# Optional for local-only runs. Do not commit a real value.
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key
STAGE=dev
INSTAGRAM_AUTOPUBLISH_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN_PARAM=/luva/social/instagram/accessToken
INSTAGRAM_IG_USER_ID=
INSTAGRAM_GRAPH_API_VERSION=v23.0
INSTAGRAM_SHARE_TO_FEED=false
TIKTOK_AUTOPUBLISH_ENABLED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_AUTH_SCOPES=video.publish
TIKTOK_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN_PARAM=/luva/social/tiktok/accessToken
TIKTOK_REFRESH_TOKEN_PARAM=/luva/social/tiktok/refreshToken
TIKTOK_TOKEN_META_PARAM=/luva/social/tiktok/tokenMeta
TIKTOK_DEFAULT_PRIVACY_LEVEL=SELF_ONLY
TIKTOK_DISABLE_COMMENT=false
TIKTOK_DISABLE_DUET=false
TIKTOK_DISABLE_STITCH=false
SOCIAL_POST_CAPTION_SUFFIX=
