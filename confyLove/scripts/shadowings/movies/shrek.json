{
  "listName": "Shrek",
  "category": "B1",
  "order": 1,
  "chapters": [
    {
      "chapter": 1,
      "title": "The Swamp",
      "level": "B1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Shrek", "voice": "male-1" },
        { "name": "Donkey", "voice": "male-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Once upon a time, there was a grumpy ogre named Shrek who lived alone in a swamp and liked it that way.", "repeat": false, "pauseAfter": 0 },
        { "character": "Shrek", "line": "Ahh, this is the life.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "Nobody bothers me here.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "I love my swamp.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "But one day, everything changed. Fairy tale creatures flooded into his swamp — Lord Farquaad had banished them all from his kingdom.", "repeat": false, "pauseAfter": 0 },
        { "character": "Shrek", "line": "What are you all doing here?", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Hey there! I'm Donkey!", "repeat": false, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Can I stay with you?", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "No! This is my swamp!", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "But I have nowhere to go.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "That's not my problem.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Lord Farquaad kicked us all out.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "Who is Lord Farquaad?", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "He rules the land of Duloc.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "He wants everything perfect and clean.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Shrek was furious. He decided to march straight to Duloc and demand his swamp back.", "repeat": false, "pauseAfter": 0 },
        { "character": "Shrek", "line": "I'm going to fix this myself.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "Nobody takes my home from me.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Wait! I'm coming with you!", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "No. I go alone.", "repeat": false, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Please? I can help.", "repeat": false, "pauseAfter": 3 },
        { "character": "Shrek", "line": "Fine. Just don't talk much.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Oh, this is so exciting!", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "I already regret this.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 2,
      "title": "The Deal",
      "level": "B1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Shrek", "voice": "male-1" },
        { "name": "Donkey", "voice": "male-2" },
        { "name": "Lord Farquaad", "voice": "male-3" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Shrek and Donkey arrived in Duloc, a spotless and perfectly arranged kingdom ruled by the very small but very demanding Lord Farquaad.", "repeat": false, "pauseAfter": 0 },
        { "character": "Shrek", "line": "So this is Duloc.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Wow! It's so clean here!", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "I need to see Farquaad.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Knights tried to capture Shrek in a tournament, but he was far too strong. Lord Farquaad watched from his throne, genuinely impressed.", "repeat": false, "pauseAfter": 0 },
        { "character": "Lord Farquaad", "line": "You are quite impressive, ogre.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "Just give me my swamp back.", "repeat": true, "pauseAfter": 3 },
        { "character": "Lord Farquaad", "line": "I have a better offer.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "I'm listening. Go on.", "repeat": true, "pauseAfter": 3 },
        { "character": "Lord Farquaad", "line": "Rescue Princess Fiona for me.", "repeat": true, "pauseAfter": 3 },
        { "character": "Lord Farquaad", "line": "She's locked in a tower.", "repeat": true, "pauseAfter": 3 },
        { "character": "Lord Farquaad", "line": "Guarded by a terrifying dragon.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "And what do I get?", "repeat": true, "pauseAfter": 3 },
        { "character": "Lord Farquaad", "line": "You get your swamp back.", "repeat": true, "pauseAfter": 3 },
        { "character": "Lord Farquaad", "line": "Everything goes back to normal.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Shrek, don't do it!", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "Deal. I'll do it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Are you serious right now?", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "I want my home back.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "What about the dragon, though?", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "We'll figure it out later.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "The deal was made. Shrek had a mission now — he just needed to survive it.", "repeat": false, "pauseAfter": 0 },
        { "character": "Donkey", "line": "So where is this tower?", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "Far, far away from here.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Great. Just great.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 3,
      "title": "Road to the Keep",
      "level": "B1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Shrek", "voice": "male-1" },
        { "name": "Donkey", "voice": "male-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "The journey to the dragon's tower began. It was a very long road, and Shrek and Donkey walked for days under the open sky.", "repeat": false, "pauseAfter": 0 },
        { "character": "Donkey", "line": "Are we there yet?", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "We barely left the swamp.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "I'm getting really hungry.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "You can eat when we arrive.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Tell me about yourself, Shrek.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "I'm an ogre. That's it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "You must have a soft side.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "Ogres are like onions.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "They stink? They make you cry?", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "They have layers. Get it?", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Oh, I see what you mean.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They finally spotted the tower rising out of a volcano in the distance, with a dragon guarding every entrance.", "repeat": false, "pauseAfter": 0 },
        { "character": "Shrek", "line": "There's the tower. We made it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "I don't like this place.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "We need a plan, Donkey.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "What's your brilliant plan, then?", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "You distract the dragon somehow.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Me? Why always me?", "repeat": false, "pauseAfter": 3 },
        { "character": "Shrek", "line": "Because you never stop talking.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "That's actually a fair point.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They crossed the rickety bridge as quietly as they could. The dragon was fast asleep, so for now, they were safe.", "repeat": false, "pauseAfter": 0 },
        { "character": "Shrek", "line": "Stay quiet. Don't wake it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Okay, okay. I'll be quiet.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "The princess must be upstairs.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "What if she doesn't want saving?", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "All princesses want to be saved.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 4,
      "title": "Dragon's Lair",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Shrek", "voice": "male-1" },
        { "name": "Donkey", "voice": "male-2" },
        { "name": "Fiona", "voice": "female-1" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Inside the tower, Shrek climbed the stairs alone while Donkey accidentally woke the dragon, who immediately began chasing him through the corridors.", "repeat": false, "pauseAfter": 0 },
        { "character": "Donkey", "line": "Nice dragon. Good dragon.", "repeat": false, "pauseAfter": 3 },
        { "character": "Donkey", "line": "You're actually quite beautiful.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Has anyone ever told you that?", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Meanwhile, Shrek found the princess's room at the top of the tower. Fiona was waiting to be rescued.", "repeat": false, "pauseAfter": 0 },
        { "character": "Shrek", "line": "Wake up! We need to go.", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "What? Who are you?", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "I'm Shrek. I'm your rescuer.", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "You're not what I expected.", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "Wait! Where is my knight?", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "You mean the guy in armor?", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "Yes! My true love!", "repeat": false, "pauseAfter": 3 },
        { "character": "Shrek", "line": "That's not really how this works.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They ran down the spiral stairs together, but the dragon had broken free and was already blocking the only exit.", "repeat": false, "pauseAfter": 0 },
        { "character": "Shrek", "line": "Donkey! Get away from the dragon!", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "I think she likes me!", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "Is that donkey talking?", "repeat": false, "pauseAfter": 3 },
        { "character": "Shrek", "line": "Don't ask. Just run.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They barely escaped. Shrek launched all three of them across the lava using a catapult, and they landed safely on the other side.", "repeat": false, "pauseAfter": 0 },
        { "character": "Fiona", "line": "That was your plan?", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "We made it, didn't we?", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "Barely! You call that a rescue?", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "You're welcome, by the way.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Can we never do that again?", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "I agree completely with you.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 5,
      "title": "Heading Home",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Shrek", "voice": "male-1" },
        { "name": "Donkey", "voice": "male-2" },
        { "name": "Fiona", "voice": "female-1" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "The three of them set off for Duloc together. Fiona had grown up expecting royal treatment, but things worked very differently with Shrek.", "repeat": false, "pauseAfter": 0 },
        { "character": "Fiona", "line": "Where are we sleeping tonight?", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "Wherever we find a spot.", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "A real knight has a horse.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "A real knight? Look around you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "Fair enough. Sorry about that.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Oh, she's funny, Shrek.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They stopped by a river to rest. Shrek tried to impress Fiona, but she turned out to have a few impressive tricks of her own.", "repeat": false, "pauseAfter": 0 },
        { "character": "Shrek", "line": "Can you actually fight?", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "I've been practicing for years.", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "Watch and learn, big guy.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "You just knocked them all out.", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "Not bad, right?", "repeat": false, "pauseAfter": 3 },
        { "character": "Shrek", "line": "Okay, I'm genuinely impressed.", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "Don't sound so surprised.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "That evening, they sat together and watched the stars come out. Something was quietly changing between them — though neither was ready to say it.", "repeat": false, "pauseAfter": 0 },
        { "character": "Fiona", "line": "The stars are beautiful tonight.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "Yeah, they really are.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Are you two flirting?", "repeat": false, "pauseAfter": 3 },
        { "character": "Shrek", "line": "No! Go to sleep, Donkey.", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "You're not what I thought.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "What did you think?", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "Ogres were supposed to be scary.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "I am scary.", "repeat": false, "pauseAfter": 3 },
        { "character": "Fiona", "line": "Maybe. But also kind of nice.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "Don't tell anyone I said thanks.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 6,
      "title": "Broken Hearts",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Shrek", "voice": "male-1" },
        { "name": "Donkey", "voice": "male-2" },
        { "name": "Fiona", "voice": "female-1" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Fiona had a secret she had never told anyone. Every night, when the last light of the sun faded, she transformed into an ogre.", "repeat": false, "pauseAfter": 0 },
        { "character": "Fiona", "line": "Donkey! Don't come in here!", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "What? Why are you an ogre?", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "It's a curse. Please don't tell.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Does Shrek know about this?", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "Nobody knows. Not even Shrek.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "But Shrek is also an ogre.", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "That's different. I am a princess.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Maybe he would understand you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "No. He must never know.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "The next morning, Shrek arrived early and overheard Fiona saying something about love — but he heard it out of context and misunderstood everything.", "repeat": false, "pauseAfter": 0 },
        { "character": "Shrek", "line": "Who were you talking about?", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "What do you mean?", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "You mentioned love. Who was it?", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "Oh... it was nothing.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Just then, a royal messenger arrived to announce that Lord Farquaad was already on his way. Shrek felt his heart break.", "repeat": false, "pauseAfter": 0 },
        { "character": "Shrek", "line": "Good. He can have you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "What did you just say?", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "That's why I'm here. The deal.", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "Is that all this was?", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "What else was it supposed to be?", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "I thought we were friends.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "Ogres don't have friends. Remember?", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Shrek! Stop it. You're wrong.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "Just go with Farquaad.", "repeat": false, "pauseAfter": 3 },
        { "character": "Fiona", "line": "Fine. I will.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 7,
      "title": "Race to the Wedding",
      "level": "C1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Shrek", "voice": "male-1" },
        { "name": "Donkey", "voice": "male-2" },
        { "name": "Fiona", "voice": "female-1" },
        { "name": "Lord Farquaad", "voice": "male-3" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Lord Farquaad arrived on horseback and proposed to Fiona on the spot. She barely had time to think — the wedding was set for that very afternoon.", "repeat": false, "pauseAfter": 0 },
        { "character": "Fiona", "line": "This is happening too fast.", "repeat": true, "pauseAfter": 3 },
        { "character": "Lord Farquaad", "line": "Smile, my soon-to-be queen.", "repeat": true, "pauseAfter": 3 },
        { "character": "Lord Farquaad", "line": "We'll be married by sunset.", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "I don't even know you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Lord Farquaad", "line": "You'll learn to love me.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Meanwhile, Shrek had returned to his empty swamp feeling utterly miserable. Donkey followed him there and refused to let him give up.", "repeat": false, "pauseAfter": 0 },
        { "character": "Donkey", "line": "You messed up big time, Shrek.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "She's a princess. I'm an ogre.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "She actually likes you, you know.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "Someone like her can't like me.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Why not? You're a good person.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "I have layers, remember?", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "So does she. Go get her.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "It might be too late.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Then we better hurry up.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They called on the dragon, who was very happy to help. Together, they flew toward Duloc as fast as they possibly could.", "repeat": false, "pauseAfter": 0 },
        { "character": "Shrek", "line": "I have to tell her something.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Tell her exactly how you feel.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "I've never done this before.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Neither have I. Just be honest.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "What do I even say?", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "Say exactly how you feel.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "What if she says no?", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "What if she says yes?", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "You know what? You're right.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "For the record, I knew it.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 8,
      "title": "True Love",
      "level": "C1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Shrek", "voice": "male-1" },
        { "name": "Donkey", "voice": "male-2" },
        { "name": "Fiona", "voice": "female-1" },
        { "name": "Lord Farquaad", "voice": "male-3" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "The wedding had already begun. Fiona stood at the altar looking lost, when suddenly Shrek burst through the great doors of the cathedral.", "repeat": false, "pauseAfter": 0 },
        { "character": "Shrek", "line": "Wait! I have something to say.", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "Shrek! What are you doing here?", "repeat": true, "pauseAfter": 3 },
        { "character": "Lord Farquaad", "line": "Guards! Remove that ogre now!", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "I was wrong. I'm so sorry.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "You are more than a princess.", "repeat": true, "pauseAfter": 3 },
        { "character": "Fiona", "line": "Shrek, it's almost sunset.", "repeat": false, "pauseAfter": 3 },
        { "character": "Shrek", "line": "Then let me say this now.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "I think I love you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "Especially because of your secret.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "The sun began to set, and Fiona started to transform right there in front of everyone. The entire church gasped.", "repeat": false, "pauseAfter": 0 },
        { "character": "Lord Farquaad", "line": "What is happening to her?", "repeat": true, "pauseAfter": 3 },
        { "character": "Donkey", "line": "It's her curse. She's an ogre.", "repeat": true, "pauseAfter": 3 },
        { "character": "Lord Farquaad", "line": "This wedding is now cancelled!", "repeat": true, "pauseAfter": 3 },
        { "character": "Shrek", "line": "I think you look beautiful.", "repeat": true, "pauseAfter": 3 },
