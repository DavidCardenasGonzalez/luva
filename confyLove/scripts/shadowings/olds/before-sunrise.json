        { "name": "Celine", "voice": "female-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "It was past midnight. They sat on a bench near a fountain. The city had grown quieter. They were running out of time and both knew it.", "repeat": false, "pauseAfter": 0 },
        { "character": "Celine", "line": "I want to ask you something serious.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Go ahead.", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "Do you think this happens often?", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "What — two people like this?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Meeting and actually connecting.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "I think it's rare. Very rare.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "I'm glad we met on that train.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "I'm glad you didn't say no.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "A long silence fell over them. A comfortable one — the kind that only exists between people who no longer need to fill the space.", "repeat": false, "pauseAfter": 0 },
        { "character": "Celine", "line": "What happens after tonight?", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "I don't know.", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "That's an honest answer.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "I don't want to promise too much.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "I don't want empty promises either.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "But I don't want this to end.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "It has to. That's the whole thing.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "What if we met again? Six months.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "This same spot.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Jesse leaned toward her. She didn't move away. When they finally kissed, it felt less like a beginning and more like a recognition.", "repeat": false, "pauseAfter": 0 },
        { "character": "Celine", "line": "I was waiting for that.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "So was I.", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "Why did you wait so long?", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "I didn't want to ruin the talking.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "The talking was the best part.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "It really was.", "repeat": false, "pauseAfter": 3 }
      ]
    },
