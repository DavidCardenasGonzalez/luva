      ],
      "dialogues": [
        { "character": "Narrator", "line": "The sky began to lighten over Vienna. They had walked all night without sleep, and now they were out of time. The train station was close.", "repeat": false, "pauseAfter": 0 },
        { "character": "Celine", "line": "It's getting light.", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "I know.", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "We should go.", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Five more minutes.", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "That won't help.", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "I know. Five more minutes anyway.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They sat on a low wall and watched the sun come up over the rooftops. All of Vienna turned orange and gold.", "repeat": false, "pauseAfter": 0 },
        { "character": "Celine", "line": "I'll remember all of this.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "What part most?", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "The talking. All of it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Six months. December. This spot.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "I'll be here.", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Promise?", "repeat": false, "pauseAfter": 3 },
