        { "character": "Jesse", "line": "Why not?", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "Because I want to mean it completely.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They walked to the station. Her train was leaving first. They didn't talk about exchanging numbers. It felt wrong somehow — like it would make the night smaller.", "repeat": false, "pauseAfter": 0 },
        { "character": "Jesse", "line": "This was real. Just so you know.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "I know it was real.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "December.", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "December.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "The train pulled away. Jesse stood on the platform until it disappeared. Then he picked up his bag and walked toward his own gate, through a city that looked completely different from the one he had arrived in the night before.", "repeat": false, "pauseAfter": 0 },
        { "character": "Jesse", "line": "I hope she comes back.", "repeat": true, "pauseAfter": 3 },
