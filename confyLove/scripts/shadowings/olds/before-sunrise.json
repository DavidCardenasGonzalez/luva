{
  "listName": "Before Sunrise",
  "category": "B1",
  "order": 1,
  "chapters": [
    {
      "chapter": 1,
      "title": "The Train",
      "level": "B1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Jesse", "voice": "male-2" },
        { "name": "Celine", "voice": "female-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Europe, 1994. A train from Budapest heading west. An American named Jesse is traveling alone to Vienna, where he will catch a flight home to the United States.", "repeat": false, "pauseAfter": 0 },
        { "character": "Jesse", "line": "Is this seat taken?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "No. Go ahead.", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Thanks. Long trip?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Paris. I started in Budapest.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Me too. Well, not Paris.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Where are you going?", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Vienna. Then home to the States.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They began to talk. Slowly at first, the way strangers do on long trains — cautiously, with nothing to lose.", "repeat": false, "pauseAfter": 0 },
        { "character": "Celine", "line": "What were you doing in Budapest?", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Traveling. Seeing things. You?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Visiting my grandmother.", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Is she doing okay?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "She's old. But still sharp.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "That's the best kind of old.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "She would agree with you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Hours passed. The conversation kept finding new things to say. Jesse had never talked this easily with someone he just met.", "repeat": false, "pauseAfter": 0 },
        { "character": "Jesse", "line": "Can I ask you something crazy?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "That depends on the question.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Get off with me in Vienna.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Excuse me?", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Just for tonight. Walk around.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "I don't know you at all.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "That's kind of the point.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "You're serious.", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Completely.", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "That's either brave or very stupid.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Maybe both. Come anyway.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 2,
      "title": "Vienna at Night",
      "level": "B1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Jesse", "voice": "male-2" },
        { "name": "Celine", "voice": "female-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Céline got off the train. Vienna at night was warm and golden. They walked without a map, without a plan.", "repeat": false, "pauseAfter": 0 },
        { "character": "Jesse", "line": "I can't believe you actually came.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "I can't believe it either.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Do you regret it already?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Ask me in the morning.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Fair enough.", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "So where are we going?", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Nowhere specific. Everywhere.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "That's not really an answer.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "That's the only honest answer.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They walked along the Ringstrasse, past lit-up cafes and old stone buildings. Céline pointed out a tram and they jumped on without thinking.", "repeat": false, "pauseAfter": 0 },
        { "character": "Celine", "line": "Do you do this kind of thing a lot?", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Convince strangers to walk with me?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Yes. Exactly that.", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "First time. You?", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "First time agreeing.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "What made you say yes?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "You seemed harmless enough.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "That's the nicest thing anyone said.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They laughed. The city moved around them quietly, indifferent to the fact that something was beginning.", "repeat": false, "pauseAfter": 0 },
        { "character": "Celine", "line": "Tell me something true about yourself.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Like what?", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "Anything. Something real.", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "I'm terrified of wasting my life.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "That's very real.", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Your turn.", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "I feel invisible sometimes. At home.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 3,
      "title": "What Do You Believe In?",
      "level": "B1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Jesse", "voice": "male-2" },
        { "name": "Celine", "voice": "female-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "They found a small park and sat on the grass. The city hummed around them. They began asking the questions people rarely ask.", "repeat": false, "pauseAfter": 0 },
        { "character": "Jesse", "line": "Do you believe in God?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "I believe in something. Not sure what.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "That's the honest version.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "What do you believe in?", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "I believe in moments.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "What does that mean?", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "That this moment is all we have.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "That sounds lonely.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Or freeing. Depends on the day.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Céline pulled her knees to her chest and thought about that. She liked how he said things — not to impress, but to figure them out.", "repeat": false, "pauseAfter": 0 },
        { "character": "Celine", "line": "I think about death a lot.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Me too. Is that strange?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Everyone does. They just don't say so.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Why do you think about it?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Because it makes the rest feel urgent.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Yes. Exactly that.", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "Do you have a theory about life?", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Many. None of them good.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "voice": "Elearning", "line": "They sat quietly for a moment, watching people pass on the nearby path. Strangers going somewhere they couldn't see.", "repeat": false, "pauseAfter": 0 },
        { "character": "Celine", "line": "I want a big life.", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "What does big mean to you?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Full. Awake. Not wasted.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Me too.", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "Then we're the same.", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "I think we might be.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 4,
      "title": "The Fortune Teller",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Jesse", "voice": "male-2" },
        { "name": "Celine", "voice": "female-2" },
        { "name": "Fortune Teller", "voice": "female-3" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Near the river they met an old woman who read palms. Céline wanted to stop. Jesse was skeptical but followed.", "repeat": false, "pauseAfter": 0 },
        { "character": "Fortune Teller", "line": "Your hand, please.", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "What do you see?", "repeat": false, "pauseAfter": 3 },
        { "character": "Fortune Teller", "line": "You are very emotional.", "repeat": true, "pauseAfter": 3 },
        { "character": "Fortune Teller", "line": "But you hide it well.", "repeat": true, "pauseAfter": 3 },
        { "character": "Fortune Teller", "line": "You will have a long, rich life.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "What about love?", "repeat": false, "pauseAfter": 3 },
        { "character": "Fortune Teller", "line": "Love finds you. Not the other way.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "The old woman smiled and walked away before either of them could ask another question.", "repeat": false, "pauseAfter": 0 },
        { "character": "Jesse", "line": "She was just telling you what you wanted.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Maybe. I still liked it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Why does that stuff appeal to people?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Because the future is terrifying.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "And a stranger's guess helps?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "It makes it feel less random.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "But it is random.", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "I know. That's why it's terrifying.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They walked along the Danube for a while. The water was dark and slow and the lights of the city fell across it.", "repeat": false, "pauseAfter": 0 },
        { "character": "Jesse", "line": "Have you ever been in love?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Yes. Once. It didn't work.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "What happened?", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "We wanted different things eventually.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "That's how it always goes.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Not always. I hope not always.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Me too.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 5,
      "title": "The Graveyard",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Jesse", "voice": "male-2" },
        { "name": "Celine", "voice": "female-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "They wandered into an old Vienna cemetery. It was quiet and still. They walked between the graves reading names and dates.", "repeat": false, "pauseAfter": 0 },
        { "character": "Celine", "line": "Does this bother you?", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "No. I find it peaceful somehow.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Me too. People think that's strange.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "People think a lot of wrong things.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Look at this one. Born 1887.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Died 1943. That's a long life.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "I wonder what she was like.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Probably a lot like you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Why do you say that?", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Just a feeling.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Céline stopped at a small grave with fresh flowers on it. Someone was still visiting. Someone still remembered.", "repeat": false, "pauseAfter": 0 },
        { "character": "Celine", "line": "This is what I'm afraid of.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Dying?", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "Being forgotten.", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Everyone gets forgotten eventually.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Thank you. That helps a lot.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Sorry. I mean — it's okay.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "It's not okay. But I accept it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Jesse looked at her in the dark between the graves. He was starting to understand that she was braver than she seemed.", "repeat": false, "pauseAfter": 0 },
        { "character": "Jesse", "line": "What would you want people to remember?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "That I was fully here.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "That I paid attention.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "I think you do.", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "Not always.", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Tonight you do.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 6,
      "title": "The Street Poet",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Jesse", "voice": "male-2" },
        { "name": "Celine", "voice": "female-2" },
        { "name": "Poet", "voice": "male-3" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "On a narrow street they found a man sitting behind a typewriter on a folding table. He wrote poems for strangers on demand.", "repeat": false, "pauseAfter": 0 },
        { "character": "Poet", "line": "A poem for you two?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Can you really do that?", "repeat": true, "pauseAfter": 3 },
        { "character": "Poet", "line": "Give me a word. Any word.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Milkshake.", "repeat": false, "pauseAfter": 3 },
        { "character": "Poet", "line": "Unusual. I'll work with it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "The poet typed for a few minutes, then pulled the page from the machine and read it aloud.", "repeat": false, "pauseAfter": 0 },
        { "character": "Poet", "line": "Dedicated to Daydream.", "repeat": true, "pauseAfter": 3 },
        { "character": "Poet", "line": "Catch the boat, daydream.", "repeat": true, "pauseAfter": 3 },
        { "character": "Poet", "line": "Believe in your magic.", "repeat": true, "pauseAfter": 3 },
        { "character": "Poet", "line": "And just say yes.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "That's beautiful.", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "How did you do that so fast?", "repeat": true, "pauseAfter": 3 },
        { "character": "Poet", "line": "I just look at the people.", "repeat": true, "pauseAfter": 3 },
        { "character": "Poet", "line": "The words come from you, not me.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They gave him some money and walked on, Céline folding the poem carefully and putting it in her pocket.", "repeat": false, "pauseAfter": 0 },
        { "character": "Jesse", "line": "Are you keeping that?", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "Of course I'm keeping it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "A poem about milkshakes.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "It wasn't really about milkshakes.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "No. I know.", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "Just say yes.", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "That part was about you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "You think?", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "You said yes tonight, didn't you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "I did.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 7,
      "title": "The Bar",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Jesse", "voice": "male-2" },
        { "name": "Celine", "voice": "female-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "They stopped at a quiet bar and ordered wine. A game began — they would each pretend to call a friend and describe the other person.", "repeat": false, "pauseAfter": 0 },
        { "character": "Jesse", "line": "Okay. Here's the game.", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Pretend you're calling your best friend.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "And tell her what? About you?", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Be honest. Say what you really think.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "That could be dangerous.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "That's why it's interesting.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Okay. Fine.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Céline held her hand up to her ear like a phone and began to speak to an imaginary friend.", "repeat": false, "pauseAfter": 0 },
        { "character": "Celine", "line": "Hi. It's me. Yes, I'm still in Vienna.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "I met this American on the train.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "He talks too much. But in a good way.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "He asks real questions.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "I think I like him. Don't tell him.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "I can hear you.", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "You're not supposed to comment.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Jesse took his turn. He spoke slower than she expected, choosing words with unusual care.", "repeat": false, "pauseAfter": 0 },
        { "character": "Jesse", "line": "Hey. It's me. Yeah, I know.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "There's this French girl.", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "She's not like anyone I've met.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "She sees things clearly.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "I don't want to get on that plane tomorrow.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Okay. Stop now.", "repeat": false, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Too honest?", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "That's the game. I can take it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Good.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 8,
      "title": "The Listening Booth",
      "level": "C1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Jesse", "voice": "male-2" },
        { "name": "Celine", "voice": "female-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "They found a small record shop still open late. The clerk let them use a listening booth — a tiny wooden room where you could hear a record in private.", "repeat": false, "pauseAfter": 0 },
        { "character": "Jesse", "line": "Have you ever been in one of these?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Once. A long time ago.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "It's like a private world inside.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Just big enough for two.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Barely.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "The music played. They stood very close, not quite looking at each other. The song was slow and low. Neither of them spoke.", "repeat": false, "pauseAfter": 0 },
        { "character": "Celine", "line": "This is a beautiful song.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Yeah.", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "You're looking at me.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "I know. Sorry.", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "Don't be sorry.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "The song ended. They stepped back out into the shop, both slightly breathless from something that hadn't technically happened yet.", "repeat": false, "pauseAfter": 0 },
        { "character": "Jesse", "line": "We should get that record.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "We don't have a record player.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "I mean it as a memory.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "A memory of tonight?", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "Of right now. This exact moment.", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "You don't need a record for that.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "How do you remember things?", "repeat": true, "pauseAfter": 3 },
