        { "character": "Jesse", "line": "What if you forget?", "repeat": true, "pauseAfter": 3 },
        { "character": "Celine", "line": "Then it becomes part of you anyway.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jesse", "line": "I like that.", "repeat": false, "pauseAfter": 3 },
        { "character": "Celine", "line": "Good.", "repeat": false, "pauseAfter": 3 }
