    {
      "chapter": 10,
      "title": "The Mall",
      "level": "C1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Seth", "voice": "male-6" },
        { "name": "Evan", "voice": "male-3" }
      ],
      "dialogues": [
        {
          "character": "Narrator",
          "text": "A few days later, Seth and Evan meet at the mall — no agenda, just walking around the way they've done since they were kids. But something is different now. The summer is almost over.",
          "repeat": false,
          "pauseAfter": 0
        },
        {
          "character": "Seth",
          "text": "I've been thinking about what you said.",
          "repeat": true,
          "pauseAfter": 3
        },
        {
          "character": "Evan",
          "text": "Which part?",
          "repeat": false,
          "pauseAfter": 3
        },
        {
          "character": "Seth",
          "text": "That things change but we don't have to.",
          "repeat": true,
          "pauseAfter": 3
        },
        {
          "character": "Evan",
          "text": "I believe that.",
          "repeat": false,
          "pauseAfter": 3
        },
        {
          "character": "Seth",
          "text": "I've depended on you too much.",
          "repeat": true,
          "pauseAfter": 3
        },
        {
          "character": "Evan",
          "text": "What are you talking about?",
          "repeat": false,
          "pauseAfter": 3
        },
        {
          "character": "Seth",
          "text": "You're my whole social life, Evan.",
          "repeat": true,
          "pauseAfter": 3
        },
        {
          "character": "Evan",
          "text": "You're mine too.",
          "repeat": false,
          "pauseAfter": 3
        },
        {
          "character": "Seth",
          "text": "That's kind of sad.",
          "repeat": true,
          "pauseAfter": 3
        },
        {
          "character": "Evan",
          "text": "Or kind of great. Depending how you look at it.",
          "repeat": true,
          "pauseAfter": 3
        },
        {
          "character": "Narrator",
          "text": "They stop walking. They're in front of their usual spot — the food court where they've eaten lunch every Saturday since sixth grade.",
          "repeat": false,
          "pauseAfter": 0
        },
        {
          "character": "Seth",
          "text": "You think we'll be this close at thirty?",
          "repeat": true,
          "pauseAfter": 3
        },
        {
          "character": "Evan",
          "text": "Honestly? I hope so.",
          "repeat": true,
          "pauseAfter": 3
        },
        {
          "character": "Seth",
          "text": "That was almost a nice thing I said.",
          "repeat": true,
          "pauseAfter": 3
        },
        {
          "character": "Evan",
          "text": "Don't ruin it.",
          "repeat": false,
          "pauseAfter": 3
        },
        {
          "character": "Seth",
          "text": "I love you, man. In a normal way.",
          "repeat": true,
          "pauseAfter": 3
        },
        {
          "character": "Evan",
          "text": "I know. Me too.",
          "repeat": false,
          "pauseAfter": 3
        },
        {
          "character": "Narrator",
          "text": "They go their separate ways in the mall — toward different stores, different escalators, different futures. But they both glance back at the same moment. And they both smile.",
          "repeat": false,
          "pauseAfter": 0
        }
      ]
    }
