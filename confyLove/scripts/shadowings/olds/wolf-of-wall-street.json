        {
          "character": "Jordan",
          "text": "I earned it. That's fair enough.",
          "repeat": true,
          "pauseAfter": 3
        },
        {
          "character": "Agent Denham",
          "text": "Don't try to charm your way out.",
          "repeat": true,
          "pauseAfter": 3
        },
        {
          "character": "Jordan",
          "text": "I'm done with the charming.",
          "repeat": true,
          "pauseAfter": 3
        },
        {
          "character": "Narrator",
          "text": "Jordan serves his time at a minimum-security facility in California, playing tennis and attending classes. It is nothing like the prison in the movies. But coming out the other side, he is genuinely a different version of himself — stripped of everything that defined him.",
          "repeat": false,
          "pauseAfter": 0
        },
        {
          "character": "Jordan",
          "text": "I had everything. I lost it all.",
          "repeat": true,
          "pauseAfter": 3
        },
        {
          "character": "Jordan",
          "text": "And somehow I still have myself.",
          "repeat": true,
          "pauseAfter": 3
        }
      ]
