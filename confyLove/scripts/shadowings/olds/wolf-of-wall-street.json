    {
      "chapter": 7,
      "title": "Arrest and Consequences",
      "level": "C1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Jordan", "voice": "male-1" },
        { "name": "Agent Denham", "voice": "male-3" },
        { "name": "Naomi", "voice": "female-1" }
      ],
      "dialogues": [
        {
          "character": "Narrator",
          "text": "Jordan is formally arrested. The charges are extensive — securities fraud, money laundering, conspiracy. He pleads guilty and cooperates with investigators, naming colleagues, partners, and associates. His world collapses with remarkable speed, as if it were always built on sand.",
          "repeat": false,
          "pauseAfter": 0
        },
        {
          "character": "Agent Denham",
          "text": "Jordan Belfort, you are under arrest.",
          "repeat": true,
          "pauseAfter": 3
        },
        {
          "character": "Jordan",
          "text": "I know. I've been expecting this.",
          "repeat": true,
          "pauseAfter": 3
        },
        {
          "character": "Agent Denham",
          "text": "You have the right to remain silent.",
          "repeat": true,
          "pauseAfter": 3
        },
        {
          "character": "Jordan",
          "text": "I waive that right. I'll cooperate.",
          "repeat": true,
          "pauseAfter": 3
