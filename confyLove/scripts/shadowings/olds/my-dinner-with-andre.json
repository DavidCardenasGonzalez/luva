{
  "listName": "My Dinner with Andre",
  "category": "B1",
  "order": 1,
  "chapters": [
    {
      "chapter": 1,
      "title": "An Invitation",
      "level": "B1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Wally", "voice": "male-3" },
        { "name": "Waiter", "voice": "male-1" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "New York City, 1981. Wally Shawn is a struggling playwright. He hasn't been very successful lately, and money is tight. Tonight he has dinner plans he has been dreading for weeks.", "repeat": false, "pauseAfter": 0 },
        { "character": "Wally", "line": "I was not looking forward to this.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Andre Gregory. My old friend.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "I hadn't seen him in years.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "People said he had gone mad.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Wandering the world. Searching.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Wally walked through the cold streets of Manhattan toward the restaurant. He rehearsed ways to leave early.", "repeat": false, "pauseAfter": 0 },
        { "character": "Wally", "line": "What would we even talk about?", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "He always made me feel small.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Not on purpose. Just by existing.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "He arrived at the restaurant. The maître d' led him to a quiet table in the back.", "repeat": false, "pauseAfter": 0 },
        { "character": "Waiter", "line": "Good evening. Can I get you something?", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Just water for now. Thank you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Waiter", "line": "Of course. Take your time.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "He was late. Of course he was.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Andre was always late.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "I ordered some bread to wait.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "And then I saw him come in.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "He looked older. But also lighter.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Like something heavy had left him.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Or maybe found him.", "repeat": false, "pauseAfter": 3 },
        { "character": "Wally", "line": "I wasn't sure which.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 2,
      "title": "Old Friends",
      "level": "B1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Wally", "voice": "male-3" },
        { "name": "Andre", "voice": "male-2" },
        { "name": "Waiter", "voice": "male-1" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Andre Gregory walked in wearing a long coat and a wide smile. He embraced Wally warmly. The dinner had begun.", "repeat": false, "pauseAfter": 0 },
        { "character": "Andre", "line": "Wally! You look wonderful.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "So do you. Really.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "It has been too long.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Years. Yes.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "I thought about you in Tibet.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "You were in Tibet?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Among other places.", "repeat": false, "pauseAfter": 3 },
        { "character": "Waiter", "line": "Are you ready to order?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "The quail, please. And some wine.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "I'll have the steak. Thank you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "The waiter left. Andre leaned forward, elbows on the table, and looked at Wally with the intensity of someone about to say something important.", "repeat": false, "pauseAfter": 0 },
        { "character": "Andre", "line": "So. How are you, Wally? Really.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "I'm fine. Writing. Struggling.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "We're all struggling. That's fine.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Is it?", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "Struggling means you're still alive.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "That's one way to look at it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "It's the only way.", "repeat": false, "pauseAfter": 3 },
        { "character": "Wally", "line": "I heard you disappeared for a while.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "I did. Completely.", "repeat": false, "pauseAfter": 3 },
        { "character": "Wally", "line": "Where did you go?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Where didn't I go?", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Tell me.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "Okay. Let me start from the beginning.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 3,
      "title": "The Expedition",
      "level": "B1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Wally", "voice": "male-3" },
        { "name": "Andre", "voice": "male-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Andre began to describe a theater expedition he had organized in Poland. Forty people. No audience. No script. Just experience.", "repeat": false, "pauseAfter": 0 },
        { "character": "Andre", "line": "We went into a forest in Poland.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "What for?", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "To find something real.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "In a forest.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "Yes. Away from all of this.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "How many people went?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Forty. From different countries.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "What happened out there?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Things I still can't explain.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Andre spoke slowly, choosing every word carefully, as if the story could break if handled wrong.", "repeat": false, "pauseAfter": 0 },
        { "character": "Andre", "line": "We stopped talking for three days.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Three days of silence?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Silence teaches you things.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Like what?", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "That you're never really alone.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Or that you always are.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Both. At the same time.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Wally poured himself some wine. He wasn't sure he believed any of it. But he was listening.", "repeat": false, "pauseAfter": 0 },
        { "character": "Wally", "line": "And theater was part of this?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Theater is just life. Observed.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "I thought it was just pretending.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Pretending is how we find truth.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "That sounds backwards to me.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Most truth sounds backwards at first.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 4,
      "title": "Buried Alive",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Wally", "voice": "male-3" },
        { "name": "Andre", "voice": "male-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Andre described the strangest moment of the expedition. The group had asked him to participate in a ritual — to be buried alive in the forest.", "repeat": false, "pauseAfter": 0 },
        { "character": "Andre", "line": "They buried me in the ground.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "They did what?", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "Buried me. Up to my neck.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "You let them do that?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "I asked them to.", "repeat": false, "pauseAfter": 3 },
        { "character": "Wally", "line": "Why on earth would you do that?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "To feel something completely real.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Were you scared?", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "Terrified. And then not at all.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Andre described lying in the earth, staring up at the trees and the night sky, feeling something shift inside him.", "repeat": false, "pauseAfter": 0 },
        { "character": "Andre", "line": "I could feel the earth breathing.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "The earth doesn't breathe, Andre.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "I know that. And I felt it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "So you imagined it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "What's the difference?", "repeat": false, "pauseAfter": 3 },
        { "character": "Wally", "line": "A very big difference.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "If you felt it, it was real.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "That can't be your definition.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "It is. It has to be.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Wally chewed his bread slowly. He found Andre's ideas both fascinating and deeply suspicious.", "repeat": false, "pauseAfter": 0 },
        { "character": "Wally", "line": "How long were you in the ground?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Long enough.", "repeat": false, "pauseAfter": 3 },
        { "character": "Wally", "line": "Long enough for what?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "To stop being afraid of death.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Did it work?", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "I'm here. So yes.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 5,
      "title": "Living Theater",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Wally", "voice": "male-3" },
        { "name": "Andre", "voice": "male-2" },
        { "name": "Waiter", "voice": "male-1" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "The food arrived. They ate slowly, and Andre shifted to talking about theater — why he had stopped working in it, and why he had started again.", "repeat": false, "pauseAfter": 0 },
        { "character": "Waiter", "line": "Is everything to your liking?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Excellent. Thank you.", "repeat": false, "pauseAfter": 3 },
        { "character": "Wally", "line": "You quit theater for years.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "I had to. It felt dead.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "All theater? Really?", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "The kind that asks nothing of you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "What do you mean by that?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "You sit. You watch. You go home.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "That's what theater is.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "That's what theater became.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Andre described experiments where the audience and performers were the same people. Where the line between watching and experiencing disappeared.", "repeat": false, "pauseAfter": 0 },
        { "character": "Andre", "line": "What if theater could change you?", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Can't a play do that?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Not if you keep it safe.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Safe is not always bad.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Safe is always a little dead.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "I disagree with that.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "Of course you do.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "There was no malice in how Andre said it. He said it the way someone says the sky is blue — as a simple observation.", "repeat": false, "pauseAfter": 0 },
        { "character": "Wally", "line": "What does that mean exactly?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "You're a careful person, Wally.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Is that wrong?", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "Not wrong. Just limited.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "I prefer the word realistic.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Realistic is just fear in a suit.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 6,
      "title": "Are We Asleep?",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Wally", "voice": "male-3" },
        { "name": "Andre", "voice": "male-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Andre began to develop his most provocative idea of the evening — that most people were sleepwalking through their lives, numbed by comfort and routine.", "repeat": false, "pauseAfter": 0 },
        { "character": "Andre", "line": "Do you think people are actually awake?", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "What do you mean, awake?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Conscious. Present. Truly alive.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Most people function just fine.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Functioning isn't the same as living.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Most people would disagree.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "That's exactly my point.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "That people disagree with you?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "That they can't see the cage.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Andre put down his fork and leaned back. His voice became slower, almost hypnotic.", "repeat": false, "pauseAfter": 0 },
        { "character": "Andre", "line": "We built a very comfortable prison.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "You mean society.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "I mean our habits. Our routines.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Routines help people survive.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Survive, yes. But not much more.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "That sounds very judgmental.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "It's an observation. Not a judgment.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Hard to tell the difference sometimes.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Wally was starting to feel defensive, though he wasn't sure why. Something in Andre's words was landing close.", "repeat": false, "pauseAfter": 0 },
        { "character": "Andre", "line": "When did you last feel truly awake?", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "I feel awake right now.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Because I'm pushing you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Maybe that's enough.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "Maybe it's a start.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 7,
      "title": "The Defense of Ordinary Life",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Wally", "voice": "male-3" },
        { "name": "Andre", "voice": "male-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Wally had been listening long enough. He set down his wine glass and decided it was time to push back.", "repeat": false, "pauseAfter": 0 },
        { "character": "Wally", "line": "I want to say something, Andre.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Please. Go ahead.", "repeat": false, "pauseAfter": 3 },
        { "character": "Wally", "line": "Not everyone can go to Tibet.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "True. But anyone can wake up.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "It's easy to say from your position.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "What position is that?", "repeat": false, "pauseAfter": 3 },
        { "character": "Wally", "line": "You had money. Freedom. Time.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Those things aren't the point.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "They kind of are the point.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Wally was warming up now. Something in him had been waiting to say this for the whole meal.", "repeat": false, "pauseAfter": 0 },
        { "character": "Wally", "line": "My life is not glamorous. Fine.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "But it is my life.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "I'm not saying it isn't.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "You're saying I'm asleep in it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "I'm asking if you're fully in it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "That's the same question.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "Only if you're afraid of the answer.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Wally felt the sting of that but didn't look away. He picked up his fork and cut into his steak deliberately.", "repeat": false, "pauseAfter": 0 },
        { "character": "Wally", "line": "What do you want from people, Andre?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "I want them to want more.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "More than what?", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "More than what they've been told to want.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "And who decides what that is?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Each person. For themselves.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Including me?", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "Especially you.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 8,
      "title": "What Is Real?",
      "level": "C1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Wally", "voice": "male-3" },
        { "name": "Andre", "voice": "male-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "The conversation turned deeper. They were no longer talking about theater or expeditions. They were talking about reality itself — what it was, and whether they were living in it.", "repeat": false, "pauseAfter": 0 },
        { "character": "Andre", "line": "Do you think this room is real?", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Yes. Obviously.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "You're sure?", "repeat": false, "pauseAfter": 3 },
        { "character": "Wally", "line": "I can touch the table.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "That just means it's physical.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Isn't that what real means?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Not necessarily. Not always.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Then what does real mean to you?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Fully felt. Fully conscious.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Andre talked about encountering people who seemed to be going through the motions — eating, working, speaking — but without any inner life behind it.", "repeat": false, "pauseAfter": 0 },
        { "character": "Andre", "line": "Have you ever met a robot person?", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "What is a robot person?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Someone there but not really there.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "We all have days like that.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "What if it becomes all your days?", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "That's depression, not philosophy.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Maybe they're the same thing.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "I don't think so.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "There was a long pause. They both reached for their wine at the same time.", "repeat": false, "pauseAfter": 0 },
        { "character": "Wally", "line": "You sound very certain about all this.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "I'm not certain. I'm searching.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "That's a long search.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "The only one worth taking.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Even if you find nothing?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Especially then.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 9,
      "title": "Simple Pleasures",
      "level": "C1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Wally", "voice": "male-3" },
        { "name": "Andre", "voice": "male-2" },
        { "name": "Waiter", "voice": "male-1" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "The plates were cleared. They ordered coffee. And Wally began to make his most personal argument of the night.", "repeat": false, "pauseAfter": 0 },
        { "character": "Wally", "line": "Can I tell you what I love?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Please.", "repeat": false, "pauseAfter": 3 },
        { "character": "Wally", "line": "My morning coffee.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "Go on.", "repeat": false, "pauseAfter": 3 },
        { "character": "Wally", "line": "My electric blanket. My cat.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Debby reading next to me in bed.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Those are beautiful things.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "You say that like they're small.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "They're not small at all.", "repeat": true, "pauseAfter": 3 },
        { "character": "Waiter", "line": "Two coffees. Can I get you anything else?", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "We're fine. Thank you.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Wally wrapped his hands around his coffee cup. He spoke quietly now, more to himself than to Andre.", "repeat": false, "pauseAfter": 0 },
        { "character": "Wally", "line": "Those things keep me going.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "They're not nothing.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "I never said they were.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "You implied it. All night.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "I'm sorry. I didn't mean to.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "But you think I'm missing something.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "I think we're all missing something.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Including you.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "Especially me.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "That stopped Wally. He looked at Andre — really looked at him — for the first time all evening. There was something tired behind his eyes.", "repeat": false, "pauseAfter": 0 },
        { "character": "Wally", "line": "Are you happy, Andre?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "I'm more awake than I was.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "That's not what I asked.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "I know.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 10,
      "title": "The Ride Home",
      "level": "C1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Wally", "voice": "male-3" },
        { "name": "Andre", "voice": "male-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "They finished their coffee. The restaurant was nearly empty now. They had been talking for hours.", "repeat": false, "pauseAfter": 0 },
        { "character": "Andre", "line": "I'm glad you came tonight.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "I almost didn't.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andre", "line": "I know. I could tell.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Was it that obvious?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Only for the first hour or so.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "I'm glad I stayed.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "Me too, Wally. Genuinely.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "I don't know what to do with all this.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andre", "line": "You don't have to do anything.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They said goodbye on the street. Wally watched Andre disappear into the night, then hailed a cab heading uptown.", "repeat": false, "pauseAfter": 0 },
        { "character": "Wally", "line": "I kept thinking about what he said.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Not the big ideas. The small ones.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "About being present. Being there.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "I passed my old neighborhood.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "The place where I grew up.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "I thought about my father.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "My mother. Both gone now.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Wally realized he was crying a little. Not from sadness exactly. From something closer to gratitude — for the meal, for the argument, for the friend.", "repeat": false, "pauseAfter": 0 },
        { "character": "Wally", "line": "Maybe Andre was right about something.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Not everything. But something.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "The coffee was still good the next morning.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "And I noticed it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Wally", "line": "Maybe that's a beginning.", "repeat": true, "pauseAfter": 3 }
      ]
    }
  ]
}
