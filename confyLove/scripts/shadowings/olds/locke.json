{
  "listName": "Locke",
  "category": "B1",
  "order": 1,
  "chapters": [
    {
      "chapter": 1,
      "title": "The Decision",
      "level": "B1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Locke", "voice": "male-3" },
        { "name": "Donal", "voice": "male-6" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Birmingham, England. Night. Ivan Locke gets into his car and starts driving south toward London. He is a construction manager. Tomorrow is the biggest concrete pour of his career. He is not going to be there.", "repeat": false, "pauseAfter": 0 },
        { "character": "Locke", "line": "Call Donal.", "repeat": false, "pauseAfter": 3 },
        { "character": "Donal", "line": "Ivan? Everything okay?", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I need you to listen carefully.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "Sure. What's going on?", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I won't be on site tomorrow.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "Sorry, what? The pour is tomorrow.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I know exactly when the pour is.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "Then why are you not coming?", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I have to be somewhere else.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Locke drove at a steady speed. His voice was calm. Whatever was happening inside him was not showing.", "repeat": false, "pauseAfter": 0 },
        { "character": "Donal", "line": "Ivan, this is the biggest job we've ever done.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I know what it is, Donal.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "Then come back. Whatever it is can wait.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "It cannot wait.", "repeat": false, "pauseAfter": 3 },
        { "character": "Donal", "line": "Ivan—", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "You are going to run it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "Me? I've never run a pour this size.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I will be on the phone all night.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "That's not the same thing.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "No. But it's what we have.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "There was a long silence on the line. Donal was afraid. Locke knew it. He kept driving.", "repeat": false, "pauseAfter": 0 },
        { "character": "Donal", "line": "Is everything alright with you?", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I've made a decision. That's all.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "Okay. I'm here.", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "Good. Now write this down.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 2,
      "title": "Telling Katrina",
      "level": "B1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Locke", "voice": "male-3" },
        { "name": "Katrina", "voice": "female-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Locke ended the call with Donal and sat in silence for a moment. Then he called home. His wife Katrina answered. She was expecting him.", "repeat": false, "pauseAfter": 0 },
        { "character": "Katrina", "line": "Hi. Are you on your way?", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I'm driving. But not home.", "repeat": true, "pauseAfter": 3 },
        { "character": "Katrina", "line": "What do you mean?", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "I'm going to London tonight.", "repeat": true, "pauseAfter": 3 },
        { "character": "Katrina", "line": "Tonight? The boys are waiting for you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I know. I'm sorry.", "repeat": false, "pauseAfter": 3 },
        { "character": "Katrina", "line": "Ivan, what's going on?", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Something happened. Last year.", "repeat": true, "pauseAfter": 3 },
        { "character": "Katrina", "line": "Something happened last year.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Yes. I need to tell you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Locke kept his eyes on the road. The motorway lights slid past in long orange streaks. He had planned this moment. It was not going the way he planned.", "repeat": false, "pauseAfter": 0 },
        { "character": "Katrina", "line": "Then tell me. Right now.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "A woman is having a baby tonight.", "repeat": true, "pauseAfter": 3 },
        { "character": "Katrina", "line": "I'm sorry?", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "The baby is mine.", "repeat": false, "pauseAfter": 3 },
        { "character": "Katrina", "line": "...", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "Katrina. Are you there?", "repeat": true, "pauseAfter": 3 },
        { "character": "Katrina", "line": "I'm here.", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "I'm going to be honest with you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Katrina", "line": "You should have been honest before.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Yes. I should have.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "She didn't hang up. That surprised him. He had expected her to hang up.", "repeat": false, "pauseAfter": 0 },
        { "character": "Katrina", "line": "How long have you known?", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Since January.", "repeat": false, "pauseAfter": 3 },
        { "character": "Katrina", "line": "That's seven months, Ivan.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Yes. It is.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 3,
      "title": "One Night",
      "level": "B1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Locke", "voice": "male-3" },
        { "name": "Katrina", "voice": "female-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Katrina stayed on the line. She asked questions. Locke answered each one honestly, without excuses, without decoration.", "repeat": false, "pauseAfter": 0 },
        { "character": "Katrina", "line": "Who is she?", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "Her name is Bethan.", "repeat": true, "pauseAfter": 3 },
        { "character": "Katrina", "line": "Do you love her?", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "No. It was one night.", "repeat": true, "pauseAfter": 3 },
        { "character": "Katrina", "line": "One night.", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "A conference in Birmingham.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "It meant nothing. That sounds terrible.", "repeat": true, "pauseAfter": 3 },
        { "character": "Katrina", "line": "It sounds honest at least.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I'm not going to lie to you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Katrina", "line": "You lied for seven months.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "He had no answer for that. He drove. The road was quiet. He could hear her breathing.", "repeat": false, "pauseAfter": 0 },
        { "character": "Locke", "line": "I didn't know how to tell you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Katrina", "line": "So you waited until tonight.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "She's alone. She has no one.", "repeat": true, "pauseAfter": 3 },
        { "character": "Katrina", "line": "And I have no one now either.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "That's not true.", "repeat": false, "pauseAfter": 3 },
        { "character": "Katrina", "line": "Isn't it?", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "The boys were in the background. Locke could hear the television. His ordinary life, still going on without him.", "repeat": false, "pauseAfter": 0 },
        { "character": "Locke", "line": "I'll explain everything when I'm back.", "repeat": true, "pauseAfter": 3 },
        { "character": "Katrina", "line": "Don't come back tonight.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Katrina—", "repeat": false, "pauseAfter": 3 },
        { "character": "Katrina", "line": "I mean it. Don't come back tonight.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Okay.", "repeat": false, "pauseAfter": 3 },
        { "character": "Katrina", "line": "I need to think.", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "I understand.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 4,
      "title": "The Pour",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Locke", "voice": "male-3" },
        { "name": "Donal", "voice": "male-6" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Donal called back. The concrete suppliers had been contacted and there was a problem. A significant one.", "repeat": false, "pauseAfter": 0 },
        { "character": "Donal", "line": "Ivan. We have a situation.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Tell me.", "repeat": false, "pauseAfter": 3 },
        { "character": "Donal", "line": "Sivwright wants confirmation in writing.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "For what exactly?", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "The mix. The timing. Everything.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Then send him the confirmation.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "It has to come from you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I'll email it from the car.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "Can you do that while driving?", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Donal. Focus. What else?", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Donal had a list. Locke worked through it methodically, one item at a time, never raising his voice.", "repeat": false, "pauseAfter": 0 },
        { "character": "Donal", "line": "The pump truck needs repositioning.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Move it to the north entrance.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "Are you sure? That adds twenty minutes.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "It adds twenty minutes of safety.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "Okay. North entrance. Got it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "What is the weather forecast?", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "Clear until five. Then rain.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Then we start no later than two.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Donal wrote everything down. He was scared but getting steadier. Locke's voice had that effect on people.", "repeat": false, "pauseAfter": 0 },
        { "character": "Donal", "line": "Ivan, are you okay? Really?", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I'm fine. Keep your mind on the job.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "Right. Sorry.", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "Don't be sorry. Just be ready.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "I'll be ready.", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "Good man.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 5,
      "title": "Gareth's Call",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Locke", "voice": "male-3" },
        { "name": "Gareth", "voice": "male-4" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "His phone rang. It was Gareth, his boss. Someone had told him. Locke had expected this call.", "repeat": false, "pauseAfter": 0 },
        { "character": "Gareth", "line": "Please tell me Donal was lying.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "He wasn't.", "repeat": false, "pauseAfter": 3 },
        { "character": "Gareth", "line": "You're not coming in tomorrow.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "That's correct.", "repeat": false, "pauseAfter": 3 },
        { "character": "Gareth", "line": "Ivan. This is the biggest pour we've ever attempted.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I know that better than anyone.", "repeat": true, "pauseAfter": 3 },
        { "character": "Gareth", "line": "Then turn the car around right now.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I can't do that.", "repeat": false, "pauseAfter": 3 },
        { "character": "Gareth", "line": "You can and you will.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "No.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Gareth's voice dropped. That was worse than shouting.", "repeat": false, "pauseAfter": 0 },
        { "character": "Gareth", "line": "Give me one reason. One.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "A child is being born tonight.", "repeat": true, "pauseAfter": 3 },
        { "character": "Gareth", "line": "Your child?", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "Yes.", "repeat": false, "pauseAfter": 3 },
        { "character": "Gareth", "line": "Does Katrina know?", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I just told her.", "repeat": false, "pauseAfter": 3 },
        { "character": "Gareth", "line": "My God.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "A long pause. Gareth was not a man who was often lost for words.", "repeat": false, "pauseAfter": 0 },
        { "character": "Gareth", "line": "If this pour fails, you are finished.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I understand that.", "repeat": false, "pauseAfter": 3 },
        { "character": "Gareth", "line": "It won't just be your job, Ivan.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I know what's at stake.", "repeat": true, "pauseAfter": 3 },
        { "character": "Gareth", "line": "Do you? Do you really?", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Donal will not let you down.", "repeat": true, "pauseAfter": 3 },
        { "character": "Gareth", "line": "You are letting me down.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Yes. I am.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 6,
      "title": "Bethan",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Locke", "voice": "male-3" },
        { "name": "Bethan", "voice": "female-1" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Bethan called. She was already at the hospital in London. She was frightened. Her voice was small and unsteady.", "repeat": false, "pauseAfter": 0 },
        { "character": "Bethan", "line": "Ivan. I'm scared.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I know. I'm on my way.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bethan", "line": "They say it could be soon.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "How far along are you?", "repeat": true, "pauseAfter": 3 },
        { "character": "Bethan", "line": "The contractions are every six minutes.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "That gives me time. Stay calm.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bethan", "line": "I don't have anyone here.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "The nurses are there.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bethan", "line": "That's not the same.", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "No. It isn't. I'm sorry.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Bethan had not planned this. She had not asked for any of it. Locke knew that.", "repeat": false, "pauseAfter": 0 },
        { "character": "Bethan", "line": "I didn't want to ruin your life.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "You didn't ruin my life.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bethan", "line": "Your wife. Your boys.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "That's my responsibility. Not yours.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bethan", "line": "Are you angry at me?", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "No. I'm not angry at you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bethan", "line": "Your voice sounds very controlled.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "That's just how I sound.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "He passed a motorway sign. London: 62 miles. He pressed the accelerator slightly harder.", "repeat": false, "pauseAfter": 0 },
        { "character": "Bethan", "line": "Will you really come?", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I'm already driving.", "repeat": false, "pauseAfter": 3 },
        { "character": "Bethan", "line": "Why? You don't have to.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I do have to.", "repeat": false, "pauseAfter": 3 },
        { "character": "Bethan", "line": "Because of the baby?", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Because it's the right thing.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 7,
      "title": "Katrina Again",
      "level": "C1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Locke", "voice": "male-3" },
        { "name": "Katrina", "voice": "female-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Katrina called back. She had been sitting alone. The boys were in bed. She had had time to think, and it had made things worse.", "repeat": false, "pauseAfter": 0 },
        { "character": "Katrina", "line": "I keep thinking about January.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "What about January?", "repeat": true, "pauseAfter": 3 },
        { "character": "Katrina", "line": "You came home. Kissed me.", "repeat": true, "pauseAfter": 3 },
        { "character": "Katrina", "line": "And you already knew.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Yes.", "repeat": false, "pauseAfter": 3 },
        { "character": "Katrina", "line": "How could you do that?", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I didn't know how to stop.", "repeat": true, "pauseAfter": 3 },
        { "character": "Katrina", "line": "Stop what?", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "Being the person you needed me to be.", "repeat": true, "pauseAfter": 3 },
        { "character": "Katrina", "line": "That's not an answer, Ivan.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "She was crying now. She was trying not to let him hear it, but he heard it.", "repeat": false, "pauseAfter": 0 },
        { "character": "Locke", "line": "I know it isn't.", "repeat": false, "pauseAfter": 3 },
        { "character": "Katrina", "line": "Did I do something wrong?", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "No. Nothing.", "repeat": false, "pauseAfter": 3 },
        { "character": "Katrina", "line": "Then why?", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "I was weak. Just once. That's it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Katrina", "line": "Once is enough.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Yes. It is.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "He wanted to pull over. He wanted to stop the car and just sit. He kept driving.", "repeat": false, "pauseAfter": 0 },
        { "character": "Katrina", "line": "I want you to know something.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Tell me.", "repeat": false, "pauseAfter": 3 },
        { "character": "Katrina", "line": "I'm not going to be here when you're ready.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I understand.", "repeat": false, "pauseAfter": 3 },
        { "character": "Katrina", "line": "Do you? Do you actually?", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I understand I've lost you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Katrina", "line": "Good.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 8,
      "title": "Talking to His Father",
      "level": "C1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Locke", "voice": "male-3" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Between calls, Locke spoke to the empty back seat of his car. His father was not there. His father had never been there. But he spoke to him anyway.", "repeat": false, "pauseAfter": 0 },
        { "character": "Locke", "line": "Are you watching? Good.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I'm doing what you never did.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "This child will know I came.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "You walked away. I didn't.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "His father had left when Ivan was young. He had never explained himself. Locke had spent his whole life being the opposite of that man.", "repeat": false, "pauseAfter": 0 },
        { "character": "Locke", "line": "I am not you.", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "I refuse to be you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "That's why I'm on this road.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Not for the woman.", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "Not for me. For the child.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "He gripped the steering wheel. The road ahead was straight and empty.", "repeat": false, "pauseAfter": 0 },
        { "character": "Locke", "line": "A child deserves better than you gave me.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Every child deserves that much.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I'm losing everything tonight.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "My wife. My job. My home.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "But this child will not lose a father.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "He said nothing for a long time. The motorway hummed under the wheels. London was getting closer.", "repeat": false, "pauseAfter": 0 },
        { "character": "Locke", "line": "Go back to wherever you are.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I don't need you to understand.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I just needed to say it out loud.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 9,
      "title": "The Pour Begins",
      "level": "C1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Locke", "voice": "male-3" },
        { "name": "Donal", "voice": "male-6" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Donal called from the site. The trucks were arriving. The pour was about to start. His voice was tight with a fear he was doing his best to control.", "repeat": false, "pauseAfter": 0 },
        { "character": "Donal", "line": "Ivan. First truck is here.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Good. Check the slump first.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "Already done. It's within spec.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Then you're in good shape.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "Ivan, there's thirty trucks coming.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "One at a time. Don't panic.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "Easy for you to say.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "You've watched me do this for years.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "Watching isn't the same as doing.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "No. But you know what to do.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Donal went quiet for a moment. On the site, engines rumbled and men shouted. Then he came back, steadier.", "repeat": false, "pauseAfter": 0 },
        { "character": "Donal", "line": "Pump truck is in position.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Good. Start the sequence.", "repeat": false, "pauseAfter": 3 },
        { "character": "Donal", "line": "Starting now. Here we go.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Stay on the line with me.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "I'm here. I'm not going anywhere.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Call me every fifteen minutes.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "Every fifteen. Got it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "The pour had begun. Hundreds of tonnes of concrete moving into place through the night. Locke listened to the sounds of the site through his phone.", "repeat": false, "pauseAfter": 0 },
        { "character": "Donal", "line": "Ivan.", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "Still here.", "repeat": false, "pauseAfter": 3 },
        { "character": "Donal", "line": "It's going well. Really well.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Of course it is.", "repeat": false, "pauseAfter": 3 },
        { "character": "Donal", "line": "You knew it would.", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "I knew you would.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 10,
      "title": "Arrival",
      "level": "C1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Locke", "voice": "male-3" },
        { "name": "Donal", "voice": "male-6" },
        { "name": "Bethan", "voice": "female-1" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "The lights of London appeared ahead. Locke had been driving for over an hour. He had lost his wife, his job, and very likely his home. He kept his eyes on the road.", "repeat": false, "pauseAfter": 0 },
        { "character": "Bethan", "line": "Ivan. It's a boy.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Is he healthy?", "repeat": false, "pauseAfter": 3 },
        { "character": "Bethan", "line": "Yes. He's healthy.", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "And you?", "repeat": false, "pauseAfter": 3 },
        { "character": "Bethan", "line": "I'm okay. I'm okay.", "repeat": false, "pauseAfter": 3 },
        { "character": "Locke", "line": "I'm ten minutes away.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bethan", "line": "You don't need to come now.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I'm coming.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "He ended the call. He took the exit toward the hospital. The city was quiet around him, indifferent.", "repeat": false, "pauseAfter": 0 },
        { "character": "Donal", "line": "Ivan. The pour is done.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Any problems?", "repeat": false, "pauseAfter": 3 },
        { "character": "Donal", "line": "None. Everything went perfectly.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "Good. You did well, Donal.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "Gareth called while you were gone.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I know what he said.", "repeat": false, "pauseAfter": 3 },
        { "character": "Donal", "line": "Are you going to be alright?", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I'll find another job.", "repeat": true, "pauseAfter": 3 },
        { "character": "Donal", "line": "That's not what I meant.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "I know what you meant.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Locke parked outside the hospital. He sat in the car for a moment. The engine ticked as it cooled. He looked at his hands on the wheel.", "repeat": false, "pauseAfter": 0 },
        { "character": "Locke", "line": "I did what I had to do.", "repeat": true, "pauseAfter": 3 },
        { "character": "Locke", "line": "That will have to be enough.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "He got out of the car and walked into the hospital. The automatic doors opened. The night was over.", "repeat": false, "pauseAfter": 0 }
      ]
    }
  ]
}
