{
  "listName": "The Breakfast Club",
  "category": "B1",
  "order": 1,
  "chapters": [
    {
      "chapter": 1,
      "title": "Five Strangers",
      "level": "B1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Vernon", "voice": "male-4" },
        { "name": "Claire", "voice": "female-4" },
        { "name": "Andrew", "voice": "male-1" },
        { "name": "Brian", "voice": "male-3" },
        { "name": "Allison", "voice": "female-1" },
        { "name": "Bender", "voice": "male-6" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Saturday, March 24, 1984. Shermer High School, Shermer, Illinois. Five students who have nothing in common arrive for eight hours of detention.", "repeat": false, "pauseAfter": 0 },
        { "character": "Vernon", "line": "You have exactly eight hours.", "repeat": true, "pauseAfter": 3 },
        { "character": "Vernon", "line": "No talking. No moving.", "repeat": true, "pauseAfter": 3 },
        { "character": "Vernon", "line": "You will sit and think.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Sounds like a great Saturday.", "repeat": true, "pauseAfter": 3 },
        { "character": "Vernon", "line": "That's one detention, Bender.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "The five students couldn't be more different. Claire, the popular girl. Andrew, the athlete. Brian, the brain. Allison, the basket case. And John Bender, the criminal.", "repeat": false, "pauseAfter": 0 },
        { "character": "Claire", "line": "Why is he sitting there?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "Just ignore him.", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "Ignore me? Nice try.", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "Can we please just be quiet?", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Relax, library boy.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "I don't belong here.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "None of us belong here.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "Speak for yourself.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Vernon left the room, warning them he'd be checking in. The students sat in silence, stealing glances at each other.", "repeat": false, "pauseAfter": 0 },
        { "character": "Brian", "line": "Do you have a pencil?", "repeat": true, "pauseAfter": 3 },
        { "character": "Allison", "line": "No.", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "She never talks, does she?", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "Leave her alone.", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "Oh, now you care.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "I always cared.", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "Sure you did, princess.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "Hey, cool it.", "repeat": false, "pauseAfter": 3 },
        { "character": "Brian", "line": "This is going to be a long day.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Eight hours. Count them.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 2,
      "title": "Don't Push Me",
      "level": "B1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Vernon", "voice": "male-4" },
        { "name": "Claire", "voice": "female-4" },
        { "name": "Andrew", "voice": "male-1" },
        { "name": "Brian", "voice": "male-3" },
        { "name": "Allison", "voice": "female-1" },
        { "name": "Bender", "voice": "male-6" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Bender couldn't sit still. He began provoking everyone in the room, testing each one to find where they'd break.", "repeat": false, "pauseAfter": 0 },
        { "character": "Bender", "line": "So what are you in for?", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "That's none of your business.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Daddy's credit card, right?", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "You don't know me at all.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "I know your type.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andrew", "line": "Back off, man.", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "Oh, the athlete speaks.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "I'm warning you.", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "Warning me of what exactly?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "You don't want to find out.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Vernon returned to check on the group. Bender immediately pushed his limits.", "repeat": false, "pauseAfter": 0 },
        { "character": "Vernon", "line": "Everything okay in here?", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Never better, Mr. V.", "repeat": true, "pauseAfter": 3 },
        { "character": "Vernon", "line": "Watch your mouth, Bender.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "I'm watching it right now.", "repeat": true, "pauseAfter": 3 },
        { "character": "Vernon", "line": "That is two detentions.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Ooh. I'm so scared.", "repeat": true, "pauseAfter": 3 },
        { "character": "Vernon", "line": "You think this is funny?", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "A little bit, yeah.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Vernon walked out, furious. The others stared at Bender in disbelief.", "repeat": false, "pauseAfter": 0 },
        { "character": "Brian", "line": "Why do you do that?", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Do what?", "repeat": false, "pauseAfter": 3 },
        { "character": "Brian", "line": "Make everything worse.", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "It can't get much worse.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "Yes, it can.", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "Not for me.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andrew", "line": "What does that mean?", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Nothing. Forget it.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 3,
      "title": "The Library Escape",
      "level": "B1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Claire", "voice": "female-4" },
        { "name": "Andrew", "voice": "male-1" },
        { "name": "Brian", "voice": "male-3" },
        { "name": "Allison", "voice": "female-1" },
        { "name": "Bender", "voice": "male-6" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Bender had a plan. He convinced the group to follow him through the school hallways to retrieve something from his locker.", "repeat": false, "pauseAfter": 0 },
        { "character": "Bender", "line": "Follow me. And be quiet.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "This is a terrible idea.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Then stay behind.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andrew", "line": "I don't like this at all.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Nobody asked you, jock.", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "What if Vernon catches us?", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Run fast. Simple.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They crept through the hallways, hearts pounding. Allison moved silently. Brian kept bumping into everything.", "repeat": false, "pauseAfter": 0 },
        { "character": "Brian", "line": "Sorry. That was me again.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "Shh! He will hear us.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Almost there. Keep moving.", "repeat": true, "pauseAfter": 3 },
        { "character": "Allison", "line": "Someone's coming.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andrew", "line": "Get down. Now.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They pressed against the wall, barely breathing. Vernon's footsteps echoed nearby, then slowly faded.", "repeat": false, "pauseAfter": 0 },
        { "character": "Bender", "line": "That was close.", "repeat": false, "pauseAfter": 3 },
        { "character": "Claire", "line": "Too close. I hate this.", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "My heart is beating so fast.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Got it. Let's go back.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "What did you just take?", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Something to make this fun.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "You're insane.", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "You're welcome.", "repeat": false, "pauseAfter": 3 },
        { "character": "Brian", "line": "I've never done this before.", "repeat": true, "pauseAfter": 3 },
        { "character": "Allison", "line": "I have.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andrew", "line": "Of course you have.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 4,
      "title": "Loosening Up",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Claire", "voice": "female-4" },
        { "name": "Andrew", "voice": "male-1" },
        { "name": "Brian", "voice": "male-3" },
        { "name": "Allison", "voice": "female-1" },
        { "name": "Bender", "voice": "male-6" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Back in the library, Bender passed around what he'd brought. One by one, they began to relax. The invisible walls between them started to crack.", "repeat": false, "pauseAfter": 0 },
        { "character": "Bender", "line": "See? Not so bad.", "repeat": false, "pauseAfter": 3 },
        { "character": "Claire", "line": "I feel a little weird.", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "Is this normal? Am I normal?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "You're fine, Brian.", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "Relax. Just breathe.", "repeat": true, "pauseAfter": 3 },
        { "character": "Allison", "line": "I like this.", "repeat": false, "pauseAfter": 3 },
        { "character": "Claire", "line": "You would.", "repeat": false, "pauseAfter": 3 },
        { "character": "Allison", "line": "What does that mean?", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "Nothing. Sorry.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Something shifted in the air. Andrew started moving to music only he could hear. Then Brian joined. Even Claire.", "repeat": false, "pauseAfter": 0 },
        { "character": "Andrew", "line": "Come on. Just dance.", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "I can't dance at all.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "Nobody cares right now.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "Oh, why not.", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "Look at you all.", "repeat": false, "pauseAfter": 3 },
        { "character": "Allison", "line": "Why aren't you dancing?", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "I don't dance.", "repeat": false, "pauseAfter": 3 },
        { "character": "Allison", "line": "Everyone dances sometimes.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "For a few minutes they were just teenagers. Not labels, not cliques. Just five people moving together in a library on a Saturday.", "repeat": false, "pauseAfter": 0 },
        { "character": "Brian", "line": "This is the most fun I've had.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "Seriously?", "repeat": false, "pauseAfter": 3 },
        { "character": "Brian", "line": "In a long time. Yeah.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "That's kind of sad.", "repeat": false, "pauseAfter": 3 },
        { "character": "Brian", "line": "I know.", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "Not sad. Just honest.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 5,
      "title": "What Are You Really Like?",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Claire", "voice": "female-4" },
        { "name": "Andrew", "voice": "male-1" },
        { "name": "Brian", "voice": "male-3" },
        { "name": "Allison", "voice": "female-1" },
        { "name": "Bender", "voice": "male-6" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "With their guards down, they started asking each other real questions. The kind you can only ask a stranger.", "repeat": false, "pauseAfter": 0 },
        { "character": "Bender", "line": "Okay. Truth. Who are you?", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "I'm popular. Everyone knows me.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "That's not who you are.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "Then what do you want?", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "I want to know the real you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "Maybe this is the real me.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "Is it though?", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Claire went quiet. It was the first time anyone had asked her that question seriously.", "repeat": false, "pauseAfter": 0 },
        { "character": "Allison", "line": "I don't talk much at school.", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "How come?", "repeat": false, "pauseAfter": 3 },
        { "character": "Allison", "line": "No one really listens.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "I would have listened.", "repeat": true, "pauseAfter": 3 },
        { "character": "Allison", "line": "You never even looked at me.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "You're right. I'm sorry.", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "Grades are everything to me.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Why? Who cares?", "repeat": false, "pauseAfter": 3 },
        { "character": "Brian", "line": "My parents care. A lot.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "So you live for them.", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "I live for everyone but me.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "The room went quiet. Each of them recognized something in Brian's words — a version of their own story.", "repeat": false, "pauseAfter": 0 },
        { "character": "Claire", "line": "My parents pick my friends.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "No way.", "repeat": false, "pauseAfter": 3 },
        { "character": "Claire", "line": "They approve who I hang out with.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "My dad lives through my wrestling.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "And none of you see it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "Do you?", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "Yeah. I see everything.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 6,
      "title": "Why We're Really Here",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Claire", "voice": "female-4" },
        { "name": "Andrew", "voice": "male-1" },
        { "name": "Brian", "voice": "male-3" },
        { "name": "Allison", "voice": "female-1" },
        { "name": "Bender", "voice": "male-6" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "The conversation turned to the real reason each of them was sitting in Saturday detention. No more deflecting.", "repeat": false, "pauseAfter": 0 },
        { "character": "Andrew", "line": "So what did you actually do?", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "I pulled a fire alarm.", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "Why?", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "Because I felt like it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "I skipped class. Big deal.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "For shopping?", "repeat": false, "pauseAfter": 3 },
        { "character": "Claire", "line": "For lunch. With my mom.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Wow. Hardcore.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andrew", "line": "I taped someone's butt cheeks together.", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "You did what?", "repeat": false, "pauseAfter": 3 },
        { "character": "Andrew", "line": "The guys dared me. I did it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Andrew's voice dropped. He wasn't proud of it. The memory seemed to carry real weight.", "repeat": false, "pauseAfter": 0 },
        { "character": "Andrew", "line": "The kid cried. He actually cried.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "That's terrible, Andrew.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "I know. I know that.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Did your dad think it was cool?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "He laughed at first.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "Then I hated myself for it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "I brought a gun to school.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "What?", "repeat": false, "pauseAfter": 3 },
        { "character": "Brian", "line": "A flare gun. Not a real one.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Brian explained that he had failed shop class. He was supposed to build a lamp and he thought he was going to lose everything over it.", "repeat": false, "pauseAfter": 0 },
        { "character": "Brian", "line": "I got an F. An actual F.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Over a lamp.", "repeat": false, "pauseAfter": 3 },
        { "character": "Brian", "line": "You don't understand the pressure.", "repeat": true, "pauseAfter": 3 },
        { "character": "Allison", "line": "I didn't do anything.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "Then why are you here?", "repeat": true, "pauseAfter": 3 },
        { "character": "Allison", "line": "I had nothing else to do.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 7,
      "title": "What Happened at Home",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Claire", "voice": "female-4" },
        { "name": "Andrew", "voice": "male-1" },
        { "name": "Brian", "voice": "male-3" },
        { "name": "Allison", "voice": "female-1" },
        { "name": "Bender", "voice": "male-6" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "They began to talk about their home lives. What had seemed like simple stories turned out to be much more complicated.", "repeat": false, "pauseAfter": 0 },
        { "character": "Allison", "line": "My parents ignore me completely.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "At least they don't fight.", "repeat": true, "pauseAfter": 3 },
        { "character": "Allison", "line": "Fighting means they notice you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "My dad never lets me forget.", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "Forget what?", "repeat": false, "pauseAfter": 3 },
        { "character": "Andrew", "line": "That he had a scholarship too.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "I'm supposed to be him.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "And if you're not?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "Then I'm nothing. That's what he says.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Bender had been quiet for a while. Then, slowly, he pulled up his sleeve and showed them the bruise on his arm.", "repeat": false, "pauseAfter": 0 },
        { "character": "Claire", "line": "Bender, what happened?", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "My dad. He gets angry.", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "He hit you?", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "It's not a big deal.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "It is a very big deal.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Don't look at me like that.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "Like what?", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "Like you feel sorry for me.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "I do feel sorry for you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Don't. I don't need that.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "The room was heavy with silence. Five teenagers staring at the floor, each carrying something no one else could see.", "repeat": false, "pauseAfter": 0 },
        { "character": "Brian", "line": "We're all kind of messed up.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Yeah. We are.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andrew", "line": "I didn't know any of this.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "Nobody knows anything about anyone.", "repeat": true, "pauseAfter": 3 },
        { "character": "Allison", "line": "That's the whole problem.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 8,
      "title": "More Than a Label",
      "level": "C1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Claire", "voice": "female-4" },
        { "name": "Andrew", "voice": "male-1" },
        { "name": "Brian", "voice": "male-3" },
        { "name": "Allison", "voice": "female-1" },
        { "name": "Bender", "voice": "male-6" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "By the afternoon, something had changed. They were no longer five strangers. They were something harder to define.", "repeat": false, "pauseAfter": 0 },
        { "character": "Bender", "line": "You'll forget us on Monday.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "That's not true.", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "You'll walk right past us.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "I won't. I promise.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Your friends won't let you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "He's right. You know he's right.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "Then maybe I'll get new friends.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "People don't change that fast.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Allison had been listening. She stood and walked over to Claire, wanting something she had never dared to ask for before.", "repeat": false, "pauseAfter": 0 },
        { "character": "Allison", "line": "Can you help me with my hair?", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "Really?", "repeat": false, "pauseAfter": 3 },
        { "character": "Allison", "line": "Just try something different.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "Okay. I can do that.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "Wow. You look really great.", "repeat": true, "pauseAfter": 3 },
        { "character": "Allison", "line": "Stop.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andrew", "line": "I mean it. Seriously.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Andrew was looking at Allison differently. He saw her — really saw her — for the very first time.", "repeat": false, "pauseAfter": 0 },
        { "character": "Brian", "line": "Should we talk about Monday?", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "What about it?", "repeat": false, "pauseAfter": 3 },
        { "character": "Brian", "line": "What happens when we see each other?", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "We say hello. That's what.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Right.", "repeat": false, "pauseAfter": 3 },
        { "character": "Andrew", "line": "We could mean it this time.", "repeat": true, "pauseAfter": 3 },
        { "character": "Allison", "line": "If we try.", "repeat": false, "pauseAfter": 3 },
        { "character": "Brian", "line": "I'll try.", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "Me too. Probably.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 9,
      "title": "The Essay",
      "level": "C1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Vernon", "voice": "male-4" },
        { "name": "Claire", "voice": "female-4" },
