        { "name": "Brian", "voice": "male-3" },
        { "name": "Allison", "voice": "female-1" },
        { "name": "Bender", "voice": "male-6" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Vernon had assigned them a thousand-word essay on who they thought they were. No one had written a single word. Then Brian volunteered to write it for all of them.", "repeat": false, "pauseAfter": 0 },
        { "character": "Brian", "line": "I'll write it. For all of us.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "You don't have to do that.", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "Someone has to. And I want to.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Write the truth. Not what he wants.", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "That's exactly what I'll write.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "What will you say?", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "I'll say we're more than that.", "repeat": true, "pauseAfter": 3 },
        { "character": "Allison", "line": "More than what?", "repeat": false, "pauseAfter": 3 },
        { "character": "Brian", "line": "More than what he sees.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Brian sat down and began to write. His voice in the letter would speak for all of them.", "repeat": false, "pauseAfter": 0 },
        { "character": "Brian", "line": "Dear Mr. Vernon.", "repeat": false, "pauseAfter": 3 },
        { "character": "Brian", "line": "We accept the labels you give us.", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "But we are more than that.", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "We are a brain.", "repeat": false, "pauseAfter": 3 },
        { "character": "Brian", "line": "And an athlete.", "repeat": false, "pauseAfter": 3 },
        { "character": "Brian", "line": "And a basket case.", "repeat": false, "pauseAfter": 3 },
        { "character": "Brian", "line": "A princess and a criminal.", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "Does that answer your question?", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Vernon returned to collect the essay. He looked at the single page — signed by Brian Johnson alone.", "repeat": false, "pauseAfter": 0 },
        { "character": "Vernon", "line": "Who wrote this?", "repeat": false, "pauseAfter": 3 },
        { "character": "Brian", "line": "I did.", "repeat": false, "pauseAfter": 3 },
        { "character": "Vernon", "line": "This isn't what I asked for.", "repeat": true, "pauseAfter": 3 },
        { "character": "Brian", "line": "No. But it's the truth.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Sincerely yours.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "The Breakfast Club.", "repeat": true, "pauseAfter": 3 }
      ]
    },
