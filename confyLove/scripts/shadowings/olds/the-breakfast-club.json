      ],
      "dialogues": [
        { "character": "Narrator", "line": "Three o'clock came. Detention was over. They walked out of the library and into the afternoon light — changed, though none of them could fully explain how.", "repeat": false, "pauseAfter": 0 },
        { "character": "Brian", "line": "So. Same time next week?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "Not funny, Brian.", "repeat": false, "pauseAfter": 3 },
        { "character": "Brian", "line": "A little funny.", "repeat": false, "pauseAfter": 3 },
        { "character": "Allison", "line": "Will you call me?", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "Yes. I will call you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Allison", "line": "You mean it?", "repeat": false, "pauseAfter": 3 },
        { "character": "Andrew", "line": "I mean every word.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Claire pulled off one of her diamond earrings and pressed it into Bender's hand. A small gesture. A real one.", "repeat": false, "pauseAfter": 0 },
        { "character": "Bender", "line": "What's this for?", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "Something to remember today.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "I won't forget today.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "I know. But keep it anyway.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "You're not so bad, you know.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "Don't push it.", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "Too late.", "repeat": false, "pauseAfter": 3 },
        { "character": "Brian", "line": "What happens to us now?", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "We figure it out.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "Together?", "repeat": false, "pauseAfter": 3 },
        { "character": "Bender", "line": "Maybe.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Bender walked out across the empty football field alone. Then he stopped, turned back toward the school, and raised his fist slowly into the air — the same fist that had caused so much trouble, now a quiet celebration of something he had never expected to feel.", "repeat": false, "pauseAfter": 0 },
        { "character": "Brian", "line": "He raised his fist for all of us.", "repeat": true, "pauseAfter": 3 },
        { "character": "Allison", "line": "Yeah. He really did.", "repeat": true, "pauseAfter": 3 },
        { "character": "Andrew", "line": "See you Monday, Allison.", "repeat": true, "pauseAfter": 3 },
        { "character": "Allison", "line": "See you Monday.", "repeat": true, "pauseAfter": 3 },
        { "character": "Claire", "line": "Don't you forget about me.", "repeat": true, "pauseAfter": 3 },
        { "character": "Bender", "line": "Never.", "repeat": false, "pauseAfter": 3 }
      ]
    }
