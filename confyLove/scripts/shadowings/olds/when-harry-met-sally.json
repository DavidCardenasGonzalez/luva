{
  "listName": "When Harry Met Sally",
  "category": "B1",
  "order": 1,
  "chapters": [
    {
      "chapter": 1,
      "title": "Can Men and Women Be Friends?",
      "level": "B1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Harry", "voice": "male-6" },
        { "name": "Sally", "voice": "female-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "It's 1977. Harry Burns and Sally Albright are sharing an eighteen-hour drive from Chicago to New York. They barely know each other.", "repeat": false, "pauseAfter": 0 },
        { "character": "Sally", "line": "So, where are you from exactly?", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "New Jersey originally.", "repeat": false, "pauseAfter": 3 },
        { "character": "Sally", "line": "Me too. Small world.", "repeat": false, "pauseAfter": 3 },
        { "character": "Harry", "line": "What are you going to do in New York?", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "I want to be a journalist.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "I'm starting law school.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "That sounds impressive.", "repeat": false, "pauseAfter": 3 },
        { "character": "Harry", "line": "It's just something I have to do.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They stop for lunch at a roadside diner. Harry already has opinions about everything, including the way Sally orders her food.", "repeat": false, "pauseAfter": 0 },
        { "character": "Harry", "line": "You order on the side, don't you?", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "I like things a certain way.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "You're what they call high maintenance.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "I just know what I like.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "That's exactly what high maintenance means.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "It is not the same thing.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Fine. You're very low maintenance.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Thank you.", "repeat": false, "pauseAfter": 3 },
        { "character": "Harry", "line": "You think you are.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "You're very annoying.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Back on the road, Harry shares his most controversial theory. Sally is not impressed at all.", "repeat": false, "pauseAfter": 0 },
        { "character": "Harry", "line": "Men and women can't be friends.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "That's a terrible thing to say.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "The sex thing always gets in the way.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Not if they're not attracted.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Men are always attracted. Always.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "I have lots of male friends.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "They all want to sleep with you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "That's completely absurd.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "I'm just being honest.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "You're impossible to talk to.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "And yet here we are.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Here we are.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 2,
      "title": "Five Years Later",
      "level": "B1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Harry", "voice": "male-6" },
        { "name": "Sally", "voice": "female-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Five years have passed. Harry and Sally run into each other at JFK Airport. Both are in serious relationships and seem happy.", "repeat": false, "pauseAfter": 0 },
        { "character": "Sally", "line": "Harry Burns. I can't believe it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Sally Albright. How are you?", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "I'm great. Really great.", "repeat": false, "pauseAfter": 3 },
        { "character": "Harry", "line": "You look exactly the same.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "So do you. Where are you headed?", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Philadelphia. Quick trip.", "repeat": false, "pauseAfter": 3 },
        { "character": "Sally", "line": "I'm going to Paris.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Fancy.", "repeat": false, "pauseAfter": 3 },
        { "character": "Sally", "line": "It's for Joe's work actually.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "You're still with Joe.", "repeat": false, "pauseAfter": 3 },
        { "character": "Sally", "line": "Of course. We're very happy.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Harry introduces his girlfriend, Amanda. She seems lovely, but the conversation gets slightly awkward almost immediately.", "repeat": false, "pauseAfter": 0 },
        { "character": "Harry", "line": "This is Amanda. My girlfriend.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "So nice to meet you, Amanda.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "She's a graphic designer.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "That sounds like fun.", "repeat": false, "pauseAfter": 3 },
        { "character": "Harry", "line": "It is. She's very talented.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "How long have you two been together?", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "About two years now.", "repeat": false, "pauseAfter": 3 },
        { "character": "Sally", "line": "That's wonderful. Good for you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They say goodbye quickly and go their separate ways, both heading in completely different directions, both apparently very happy.", "repeat": false, "pauseAfter": 0 },
        { "character": "Harry", "line": "Well, it was great seeing you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "You too. Have a safe trip.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Give my best to Joe.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "I will. Enjoy Philadelphia.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Take care, Sally.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Bye, Harry.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 3,
      "title": "Ten Years Later",
      "level": "B1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Harry", "voice": "male-6" },
        { "name": "Sally", "voice": "female-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "It's 1987. Ten years after their road trip, Harry and Sally are on the same flight back to New York. This time, both of them are single.", "repeat": false, "pauseAfter": 0 },
        { "character": "Sally", "line": "Harry Burns. I don't believe it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Sally Albright. Small world.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Are you moving back to New York?", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Helen and I split up.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Oh no. I'm so sorry.", "repeat": false, "pauseAfter": 3 },
        { "character": "Harry", "line": "It happens. How about Joe?", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "We grew apart.", "repeat": false, "pauseAfter": 3 },
        { "character": "Harry", "line": "That's a polite way to say it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "We just wanted different things.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Don't we all.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They sit together on the plane, talking for hours. Something about this third encounter feels different from the others.", "repeat": false, "pauseAfter": 0 },
        { "character": "Harry", "line": "Do you read the last page first?", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "No. That ruins the whole book.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "I always read the last page.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Why would you do that?", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "In case I die before finishing.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "That is so morbid.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "I'm just being practical.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "You're being strange.", "repeat": false, "pauseAfter": 3 },
        { "character": "Harry", "line": "I've heard that before.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They land in New York. Harry suggests they share a cab. Then he says something that surprises them both.", "repeat": false, "pauseAfter": 0 },
        { "character": "Harry", "line": "Maybe we could be friends now.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "I thought that was impossible.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Maybe I was wrong.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "You? Wrong about something?", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "It happens. Occasionally.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Okay. Let's try it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Great. Friends.", "repeat": false, "pauseAfter": 3 },
        { "character": "Sally", "line": "Friends.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 4,
      "title": "Just Friends",
      "level": "B1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Harry", "voice": "male-6" },
        { "name": "Sally", "voice": "female-2" },
        { "name": "Marie", "voice": "female-4" },
        { "name": "Jess", "voice": "male-1" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Harry and Sally start spending time together. They walk through Central Park, talk on the phone late at night, and share everything.", "repeat": false, "pauseAfter": 0 },
        { "character": "Sally", "line": "How was your date last night?", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Terrible. She chewed so loud.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "You can't end it over chewing.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Watch me.", "repeat": false, "pauseAfter": 3 },
        { "character": "Sally", "line": "You are impossible to please.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "I'm specific about what I want.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "You mean incredibly picky.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Specific. Completely different thing.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Sally introduces Harry to her best friend Marie. Harry brings his friend Jess. Something unexpected sparks between the two of them.", "repeat": false, "pauseAfter": 0 },
        { "character": "Marie", "line": "Is he seeing anyone right now?", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Marie, we just sat down.", "repeat": true, "pauseAfter": 3 },
        { "character": "Marie", "line": "I know what I want.", "repeat": true, "pauseAfter": 3 },
        { "character": "Jess", "line": "So, Marie, what do you do?", "repeat": true, "pauseAfter": 3 },
        { "character": "Marie", "line": "Interior design. And you?", "repeat": false, "pauseAfter": 3 },
        { "character": "Jess", "line": "I write. Books, mostly.", "repeat": false, "pauseAfter": 3 },
        { "character": "Marie", "line": "That's genuinely impressive.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "They're completely going to date.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Don't jinx it.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Harry and Sally talk on the phone every single night. Their friendship becomes the most important relationship either of them has.", "repeat": false, "pauseAfter": 0 },
        { "character": "Harry", "line": "I called you three times today.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "I know. I was working.", "repeat": false, "pauseAfter": 3 },
        { "character": "Harry", "line": "I miss you when you're busy.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "That's actually really sweet.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Don't read too much into it.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Too late, Harry.", "repeat": false, "pauseAfter": 3 },
        { "character": "Harry", "line": "You're my best friend, you know.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "You're mine too.", "repeat": false, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 5,
      "title": "I'll Have What She's Having",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Harry", "voice": "male-6" },
        { "name": "Sally", "voice": "female-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Harry and Sally are having lunch at Katz's Delicatessen in lower Manhattan. Their conversation drifts into dangerous territory.", "repeat": false, "pauseAfter": 0 },
        { "character": "Harry", "line": "Women fake it all the time.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "That is not true.", "repeat": false, "pauseAfter": 3 },
        { "character": "Harry", "line": "It absolutely is.", "repeat": false, "pauseAfter": 3 },
        { "character": "Sally", "line": "Most women don't do that.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "How would you know?", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Because I am one.", "repeat": false, "pauseAfter": 3 },
        { "character": "Harry", "line": "Have you ever faked it?", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "No. Absolutely not.", "repeat": false, "pauseAfter": 3 },
        { "character": "Harry", "line": "Then you're the exception.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "I'm not the exception.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Every man thinks he can tell.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "And they can't.", "repeat": false, "pauseAfter": 3 },
        { "character": "Harry", "line": "I can always tell.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Oh really. You're so sure?", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "One hundred percent sure.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "What happens next stops the entire restaurant. Sally gives a very convincing demonstration, right there at the lunch table.", "repeat": false, "pauseAfter": 0 },
        { "character": "Harry", "line": "Are you finished?", "repeat": false, "pauseAfter": 3 },
        { "character": "Sally", "line": "Yes. And you were wrong.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "That was... extremely convincing.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Thank you. I thought so.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "You've made your point.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "I always make my point.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "An older woman at the next table has watched the whole thing. When the waiter comes to take her order, she doesn't hesitate.", "repeat": false, "pauseAfter": 0 },
        { "character": "Harry", "line": "Everyone is staring at us.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Good. Now they know.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Know what exactly?", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "That you don't know everything.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 6,
      "title": "Blind Dates and Mixed Signals",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Harry", "voice": "male-6" },
        { "name": "Sally", "voice": "female-2" },
        { "name": "Marie", "voice": "female-4" },
        { "name": "Jess", "voice": "male-1" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Harry and Sally decide to set each other up on blind dates. They arrange a double dinner, thinking it's a perfect plan.", "repeat": false, "pauseAfter": 0 },
        { "character": "Sally", "line": "I found someone perfect for you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "What's wrong with her?", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Nothing. She's smart and funny.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "They're always great until they aren't.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Just give her a chance.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Fine. I found someone for you too.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Tell me about him.", "repeat": false, "pauseAfter": 3 },
        { "character": "Harry", "line": "A doctor. Very successful guy.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "That actually sounds promising.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "The double dinner is polite but flat. Harry and Sally keep looking at each other across the table more than at their actual dates.", "repeat": false, "pauseAfter": 0 },
        { "character": "Jess", "line": "So how do you two know each other?", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Long story. Very long drive.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "We go way back.", "repeat": false, "pauseAfter": 3 },
        { "character": "Marie", "line": "They bicker like a married couple.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "We're just good friends.", "repeat": false, "pauseAfter": 3 },
        { "character": "Sally", "line": "Very good friends.", "repeat": false, "pauseAfter": 3 },
        { "character": "Marie", "line": "Sure.", "repeat": false, "pauseAfter": 3 },
        { "character": "Narrator", "line": "After dinner, Harry walks Sally home. Neither of them mentions how bored they were with their dates.", "repeat": false, "pauseAfter": 0 },
        { "character": "Harry", "line": "So, did you like him at all?", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "He was fine. You like her?", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "She was fine.", "repeat": false, "pauseAfter": 3 },
        { "character": "Sally", "line": "Fine isn't really very great.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "No. It really isn't.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Maybe we set the bar too high.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Or maybe something else entirely.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "What does that mean?", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Nothing. Good night, Sally.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 7,
      "title": "The Mistake",
      "level": "B2",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Harry", "voice": "male-6" },
        { "name": "Sally", "voice": "female-2" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Sally calls Harry late one night, crying. She just found out her ex-boyfriend Joe is getting married. Harry comes over immediately.", "repeat": false, "pauseAfter": 0 },
        { "character": "Sally", "line": "Joe is getting married.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Oh no. Are you okay?", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "I thought I was over him.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "You are over him. It just hurts.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "What is wrong with me?", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Nothing is wrong with you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "I'm going to be alone forever.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "You're not going to be alone.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "How could you possibly know that?", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Because you're wonderful, Sally.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "They hold each other on the couch. The comfort becomes something more. But the morning after changes everything between them.", "repeat": false, "pauseAfter": 0 },
        { "character": "Sally", "line": "This was a mistake.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Sally, wait. Don't say that.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "I shouldn't have called you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "Of course you should have.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "This changes everything, Harry.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "It doesn't have to change anything.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "It already has.", "repeat": false, "pauseAfter": 3 },
        { "character": "Harry", "line": "Can we please just talk?", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "Please just go, Harry.", "repeat": true, "pauseAfter": 3 },
        { "character": "Narrator", "line": "Harry leaves, confused and shaken. Sally closes the door and leans against it, knowing that something has been permanently broken.", "repeat": false, "pauseAfter": 0 },
        { "character": "Harry", "line": "I don't want to lose you.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "You're losing me right now.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "That's not fair at all.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "No, Harry. It isn't.", "repeat": true, "pauseAfter": 3 }
      ]
    },
    {
      "chapter": 8,
      "title": "Everything Is Ruined",
      "level": "C1",
      "characters": [
        { "name": "Narrator", "voice": "Elearning" },
        { "name": "Harry", "voice": "male-6" },
        { "name": "Sally", "voice": "female-2" },
        { "name": "Marie", "voice": "female-4" },
        { "name": "Jess", "voice": "male-1" }
      ],
      "dialogues": [
        { "character": "Narrator", "line": "Weeks pass. Harry and Sally avoid each other completely. When they meet at a party for Jess and Marie, the tension is unbearable.", "repeat": false, "pauseAfter": 0 },
        { "character": "Jess", "line": "You two are making this very weird.", "repeat": true, "pauseAfter": 3 },
        { "character": "Harry", "line": "We're not doing anything.", "repeat": true, "pauseAfter": 3 },
        { "character": "Marie", "line": "You haven't spoken all evening.", "repeat": true, "pauseAfter": 3 },
        { "character": "Sally", "line": "We're absolutely fine.", "repeat": false, "pauseAfter": 3 },
