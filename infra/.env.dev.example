# Dev backend environment. Copy to `.env.dev` and replace placeholders.
# Do not paste production Cognito, social, or RevenueCat secrets here unless you
# intentionally want dev to use those external services.

LUVA_STAGE="dev"
LUVA_STACK_NAME="LuvaDevStack"
COGNITO_CALLBACK_URLS="luvadev://callback,exp://127.0.0.1:19000,exp://localhost:19000,http://localhost:5173/,http://localhost:5174/"
COGNITO_LOGOUT_URLS="luvadev://callback,http://localhost:5173/,http://localhost:5174/"
COGNITO_DOMAIN_PREFIX="luva-dev-yourname"

# Optional: enable Google in the dev Cognito Hosted UI.
# Prefer a separate OAuth client configured with `luvadev://callback`.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: enable Apple in the dev Cognito Hosted UI.
# Prefer a separate Apple Service ID for dev.
APPLE_SERVICE_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# RevenueCat dev/test values.
REVENUECAT_SECRET_KEY=""
REVENUECAT_ENTITLEMENT_ID="Luva Pro"

# Keep automated social publishing off in dev unless explicitly testing it.
INSTAGRAM_AUTOPUBLISH_ENABLED="false"
INSTAGRAM_IG_USER_ID=""
INSTAGRAM_GRAPH_API_VERSION="v23.0"
INSTAGRAM_SHARE_TO_FEED="false"

TIKTOK_AUTOPUBLISH_ENABLED="false"
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI=""
TIKTOK_AUTH_SCOPES="video.publish"
TIKTOK_DEFAULT_PRIVACY_LEVEL="SELF_ONLY"
TIKTOK_DISABLE_COMMENT="false"
TIKTOK_DISABLE_DUET="false"
TIKTOK_DISABLE_STITCH="false"

SOCIAL_POST_CAPTION_SUFFIX=""

# Set these SSM parameters after deploy with real tokens:
# /luva/dev/openai/apiKey
# /luva/dev/fal/apiKey
# /luva/dev/gemini/apiKey
# /luva/dev/google/translateApiKey
